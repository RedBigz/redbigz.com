<script>
  // tags

  const tags = [
    "--commissions-are-open",
    "--silly-fox",
    "--trust-me-bro",
    "--silly-when-your-workflow-isnt",
  ];

  const taglineElement = document.querySelector("#tagline") as HTMLSpanElement;

  function setNewTag() {
    taglineElement.innerText = tags[Math.floor(Math.random() * tags.length)];
  }

  setNewTag();

  taglineElement.addEventListener("click", setNewTag);
</script>


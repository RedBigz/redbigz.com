---
const { title, grow } = Astro.props;
---

<div id="container-block">
  <slot />
</div>

<style define:vars={{ grow }} is:global>
  #container-block {
    display: inline-block;
    margin: 1ch;
    padding: 10px;
    background-color: #454757;
    border-radius: 10px;
    flex: var(--grow);
  }

  #container-block h3 {
    /* line-height: 1px; */
    margin-top: 0;
    margin-bottom: 0;
  }
</style>

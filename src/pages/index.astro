---
// import CommissionsBlock from "../components/CommissionsBlock.astro";
// import ContainerBlock from "../components/ContainerBlock.astro";
// import Header from "../components/Header.astro";
// import Pronouns from "../components/Pronouns.astro";
import Badges from "../layouts/homepage/Badges.astro";
import GridBoxContainer from "../components/GridBoxContainer.astro";
import GridBox from "../components/GridBox.astro";
import GridBoxBreak from "../components/GridBoxBreak.astro";
import MainLayout from "../layouts/MainLayout.astro";
import Intro from "../layouts/homepage/Intro.astro";
import GoodPadding from "../layouts/GoodPadding.astro";
import Socials from "../layouts/homepage/Socials.astro";
import Time from "../layouts/homepage/Time.astro";
import GridBoxHeading from "../components/GridBoxHeading.astro";
import Projects from "../layouts/homepage/Projects.astro";
import HireMe from "../layouts/homepage/HireMe.astro";
import Special from "../layouts/homepage/Special.astro";
---

<MainLayout>
  <GoodPadding>
    <GridBoxContainer minWidth="250px">
      <Intro />

      <GridBoxContainer>
        <Time />

        <GridBoxBreak />

        <GridBox>
          <Socials />
        </GridBox>
      </GridBoxContainer>

      <HireMe />

      <Projects />

      <GridBoxHeading><h3>Miscellaneous</h3></GridBoxHeading>

      <!-- 2.1 fits 6 88x31s at max width -->
      <GridBox grow="2.1">
        <Badges />
      </GridBox>

      <GridBox minWidth="250px">
        <Special />
      </GridBox>
    </GridBoxContainer>

    <GridBoxHeading>
      $ redbigz --silly-when-your-workflow-isnt<br />
      &copy; 2023-2026 redbigz.com
    </GridBoxHeading>
  </GoodPadding>
</MainLayout>
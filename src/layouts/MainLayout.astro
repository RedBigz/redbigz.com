---
import { Font } from "astro:assets";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>redbigz.com</title>
    
    <!-- <script is:inline src="https://code.jquery.com/jquery-3.7.0.min.js"></script> -->

    <Font cssVariable="--font-mono" preload />

    <style is:global>
      :root {
        --accent: #f5c2e7;
        --background: #181825;
      }

      @supports (scrollbar-color: auto) {
        body {
          scrollbar-color: var(--background) var(--accent);
        }
      }
      

      @supports selector(::-webkit-scrollbar) {
        ::-webkit-scrollbar {
          background-color: var(--background);
          width: 10px;
        }

        ::-webkit-scrollbar-thumb {
          background-color: #1e1e2e;
        }

        ::-webkit-scrollbar-thumb:hover {
          background-color: color-mix(in oklch, #1e1e2e, var(--accent) 20%);
        }

        ::-webkit-scrollbar-thumb:active {
          background-color: color-mix(in oklch, #1e1e2e, var(--accent) 40%);
        }
      }

      body {
        font-family: var(--font-mono);
        font-size: 12pt;
        background: var(--background);
        background-size: cover;
        color: white;
        margin: 0;
      }

      h2,h3,h4 {
        margin-top: 2pt;
        margin-bottom: 2pt;
      }

      a {
        color: var(--accent);
      }

      ul {
        padding-left: 20px;
      }
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>
